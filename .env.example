# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Scorecard ────────────────────────────────────────────────────────────────
# Found at: https://app.scorecard.io/settings/api-keys
SCORECARD_API_KEY=ak_...

# Your Scorecard project ID (from the project URL or settings)
SCORECARD_PROJECT_ID=123

# Comma-separated metric IDs to use for LLM-judge scoring (optional for traces-only demo)
# Leave empty to skip scoring and just capture traces: SCORECARD_METRIC_IDS=
SCORECARD_METRIC_IDS=456,789

# ── OTel Tracing → Scorecard ─────────────────────────────────────────────────
# These tell the Claude Agent SDK subprocess where to export traces.
# The SDK reads these env vars when it starts the claude CLI subprocess.

# Scorecard's OTLP trace ingest endpoint
BETA_TRACING_ENDPOINT=https://tracing.scorecard.io/otel

# Authorization header for the OTLP exporter (same API key as above)
OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer ak_...

# Enable detailed span capture (tool inputs/outputs, token counts, etc.)
ENABLE_BETA_TRACING_DETAILED=1

# NOTE: OTEL_RESOURCE_ATTRIBUTES is intentionally NOT set here.
# main.py injects it dynamically per test case via ClaudeAgentOptions(env=...)
# so each run carries the correct scorecard.otel_link_id for trace-record linking.
